# ==========================================
# OpenAI Course Automation Configuration
# ==========================================

# Your OpenAI API Key (required for vision and quiz answering)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model to use:
# - gpt-6-luna: High-speed, cost-efficient, 1M context with configurable reasoning & vision (Luna series)
# - gpt-4o (or gpt-4o-2024-11-20): Fast, highly intelligent flagship vision & structured outputs
# - gpt-4.5-preview: OpenAI's largest model with deepest world knowledge
# - o1: Deep deliberate chain-of-thought reasoning with vision
OPENAI_MODEL=gpt-6-luna

# Optional: Credentials for auto-filling login (or leave blank to click 'Sign in with ChatGPT')
OPENAI_EMAIL=
OPENAI_PASSWORD=

# Target course URL in OpenAI Academy
COURSE_URL=https://academy.openai.com/learning-path/ai-foundations-dnq5w/learn/ai-foundations-juzjs/lessons

# Browser Headless mode: false (recommended so you see the course and login), true for headless
HEADLESS=false

# Browser slow motion delay in milliseconds between actions
SLOW_MO_MS=1000

# Persistent user data directory to store login cookies and session
USER_DATA_DIR=./browser_profile

# Optional: Connect to an existing running Chrome instance (leave empty to launch new browser with profile)
# Example: http://localhost:9222
CDP_URL=

# Max steps per run before safety stop
MAX_STEPS=150

# Delay (seconds) to simulate human reading before clicking next
READING_DELAY_SECONDS=3.0
